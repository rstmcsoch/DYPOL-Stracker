# Public, client-side values only. Anything prefixed EXPO_PUBLIC_ is compiled into the app.
# Never put the Supabase service-role key, AI provider keys, or keystore passwords here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# The deployed website hosts the authenticated /api/ai/* routes the app calls.
EXPO_PUBLIC_API_BASE_URL=https://dypol-stracker.vercel.app
