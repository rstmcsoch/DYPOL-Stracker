# Public, client-side values only. Anything prefixed EXPO_PUBLIC_ is compiled into the app.
# Never put the Supabase service-role key (an sb_secret_ key, or a JWT whose role is service_role),
# AI provider keys, or keystore passwords here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The project's publishable key (Dashboard > Project Settings > API). This is the canonical name.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Alias for projects that still use the legacy anon key. If both are set, the publishable key wins.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The deployed website hosts the authenticated /api/ai/* routes the app calls.
EXPO_PUBLIC_API_BASE_URL=https://dypol-stracker.vercel.app
