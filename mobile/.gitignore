# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# Public release certificate only. Private keys (*.pem, *.p12, *.key) stay ignored.
!release-signing/*.cert.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Stracker release signing and local secrets. Never commit these; see docs/mobile/release-signing.md.
credentials/
.env
.env.*
!.env.example
*.keystore
*.apk
*.aab
*.apks
*.idsig

