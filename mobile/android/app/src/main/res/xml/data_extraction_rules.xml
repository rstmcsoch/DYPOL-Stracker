<?xml version="1.0" encoding="utf-8"?>
<!-- The notebook cache holds study data; it is not worth restoring to another device and
     must never be copied out of the app's private directory. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
