# Public browser keys. Only variables prefixed with VITE_ enter the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Server-only values for the Vercel AI API. Configure in Vercel Project Settings,
# or in a private local server environment. Do not prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-secret
AI_CREDENTIALS_ENCRYPTION_KEY=64-hex-characters-generated-with-openssl-rand-hex-32
